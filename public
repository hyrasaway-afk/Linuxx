
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b0b12">
<title>Linux Downloader</title>
<style>
:root{--bg:#0b0b12;--panel:#14141e;--panel2:#1b1b28;--line:#2a2a3b;--text:#f6f5fb;--muted:#a5a4b7;--accent:#9b6cff;--accent2:#6c4de6;--green:#5ce0a0}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#30204f 0,transparent 45%),var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;min-height:100vh}
.wrap{max-width:1040px;margin:auto;padding:24px 20px 60px}.nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:60px}.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:20px;letter-spacing:-.5px}.logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#b58cff,#6d4de6);display:grid;place-items:center;box-shadow:0 8px 30px #7650d455}.logo svg{width:24px}.nav-tag{font-size:12px;color:#c6b7ff;background:#241b39;border:1px solid #45336b;padding:8px 12px;border-radius:999px}
.hero{text-align:center;max-width:760px;margin:0 auto 34px}.eyebrow{display:inline-flex;gap:8px;align-items:center;color:#c7b4ff;background:#211a32;border:1px solid #40315d;border-radius:99px;padding:7px 12px;font-size:12px;margin-bottom:18px}.dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px #5ce0a0}.hero h1{font-size:clamp(34px,6vw,58px);line-height:1.15;margin:0 0 16px;letter-spacing:-1.5px}.hero h1 span{background:linear-gradient(90deg,#c5a9ff,#8b6bff);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{color:var(--muted);font-size:16px;line-height:1.8;margin:0 auto;max-width:600px}
.downloader{max-width:760px;margin:auto;background:linear-gradient(180deg,#191824,#12121a);border:1px solid #302d42;border-radius:24px;padding:14px;box-shadow:0 24px 80px #0005}.inputrow{display:flex;gap:10px;background:#0e0e16;border:1px solid #29283a;border-radius:16px;padding:8px}.inputrow input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:var(--text);padding:12px;font-size:15px;direction:ltr;text-align:left}.inputrow input::placeholder{color:#77768b}.paste{border:1px solid #343246;background:#20202d;color:#d8d6e8;border-radius:11px;padding:0 14px;cursor:pointer;font-weight:600}.go{display:flex;justify-content:center;align-items:center;gap:9px;width:100%;margin-top:10px;padding:15px;border:0;border-radius:14px;background:linear-gradient(100deg,#9d70ff,#704de4);color:white;font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 8px 25px #7952e433}.go:active{transform:scale(.99)}.hint{text-align:center;color:#77768b;font-size:12px;margin:13px 0 3px}.result{display:none;margin-top:14px;border:1px solid var(--line);border-radius:16px;background:#11111a;padding:16px}.result.show{display:block}.resulttop{display:flex;gap:14px;align-items:center}.thumb{width:88px;height:70px;border-radius:12px;background:linear-gradient(135deg,#32234e,#1b1b2b);display:grid;place-items:center;flex-shrink:0;color:#c6b2ff}.result h3{margin:0 0 5px;font-size:15px}.result p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.quality{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}.quality button{border:1px solid #39364d;background:#1b1a27;color:#ddd9ef;border-radius:10px;padding:9px 13px;cursor:pointer}.quality button.active{border-color:#9a76ff;background:#302347;color:#fff}.downloadmock{margin-top:12px;color:#9c88d9;font-size:12px}
.features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:42px 0}.feature{background:#13131c;border:1px solid #252535;border-radius:18px;padding:20px}.feature .ico{width:38px;height:38px;border-radius:12px;background:#28203d;color:#bba3ff;display:grid;place-items:center;margin-bottom:14px}.feature h3{font-size:15px;margin:0 0 8px}.feature p{font-size:13px;color:var(--muted);line-height:1.7;margin:0}.platforms{text-align:center;margin:34px 0}.platforms h2{font-size:18px;margin-bottom:18px}.chips{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}.chip{border:1px solid #2c2b3b;background:#15151f;color:#c5c3d5;border-radius:999px;padding:9px 14px;font-size:13px}.notice{border:1px solid #3a304e;background:#171321;color:#bcb5cf;border-radius:14px;padding:14px 16px;font-size:12px;line-height:1.8}.footer{text-align:center;color:#656477;font-size:12px;margin-top:36px}
@media(max-width:650px){.wrap{padding:18px 14px 40px}.nav{margin-bottom:42px}.hero h1{font-size:36px}.hero p{font-size:14px}.downloader{padding:10px;border-radius:19px}.inputrow{gap:5px}.inputrow input{padding:10px;font-size:13px}.paste{padding:0 10px;font-size:12px}.features{grid-template-columns:1fr;margin:28px 0}.feature{display:flex;gap:13px;padding:16px}.feature .ico{flex-shrink:0;margin:0}.feature h3{margin-top:2px}.resulttop{align-items:flex-start}}
</style>
</head>
<body>
<div class="wrap">
<header class="nav">
<div class="brand"><div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14l2 5-9 11L3 9z"/><path d="M3 9h18M9 4l3 5 3-5"/></svg></div><span>Linux <span style="color:#b69aff">Downloader</span></span></div>
<div class="nav-tag">نسخة تجريبية</div>
</header>
<section class="hero">
<div class="eyebrow"><span class="dot"></span> تنزيل سريع • واجهة بسيطة</div>
<h1>فيديوهاتك المفضلة،<br><span>في مكان واحد</span></h1>
<p>الصق رابط الفيديو من منصتك المفضلة، واستعد لتنزيله بسهولة. تجربة نظيفة، سريعة، ومصممة لهاتفك.</p>
</section>
<section class="downloader">
<div class="inputrow"><input id="url" type="url" placeholder="https://..." aria-label="رابط الفيديو"><button class="paste" id="paste">لصق الرابط</button></div>
<button class="go" id="process"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m-5-5 5 5 5-5M5 20h14"/></svg> تحليل الرابط</button>
<div class="hint">يدعم الروابط العامة التي تسمح المنصة بتنزيلها</div>
<div class="result" id="result"><div class="resulttop"><div class="thumb"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m10 9 5 3-5 3z"/></svg></div><div><h3 id="platform">تم التعرف على الرابط</h3><p id="message">واجهة تجريبية — يلزم ربط خدمة معالجة الفيديو لإظهار خيارات التنزيل الحقيقية.</p></div></div><div class="quality"><button class="active">أفضل جودة</button><button>720p</button><button>480p</button><button>صوت MP3</button></div><div class="downloadmock">خيارات الجودة تظهر بعد ربط خدمة التنزيل.</div></div>
</section>
<section class="features">
<div class="feature"><div class="ico">↯</div><div><h3>تنزيل بخطوات بسيطة</h3><p>واجهة واضحة تساعدك على الوصول إلى الفيديو بسرعة وبأقل عدد من الخطوات.</p></div></div>
<div class="feature"><div class="ico">◈</div><div><h3>جودات متعددة</h3><p>اختيار الدقة والصيغة عندما توفرها خدمة المصدر.</p></div></div>
<div class="feature"><div class="ico">▣</div><div><h3>مصمم للهاتف</h3><p>تصميم متجاوب يدعم الشاشات الصغيرة ويمكن تثبيته كتطبيق ويب.</p></div></div>
</section>
<section class="platforms"><h2>منصات شائعة</h2><div class="chips"><span class="chip">TikTok</span><span class="chip">Instagram</span><span class="chip">Facebook</span><span class="chip">X</span><span class="chip">YouTube*</span></div></section>
<div class="notice">تنويه: هذه نسخة واجهة أولية. التنزيل الفعلي يحتاج إلى backend أو API موثوق يدعم المنصات المطلوبة. لا يمكن تجاوز المحتوى الخاص أو قيود المنصة، ويجب احترام حقوق النشر وشروط الاستخدام.</div>
<footer class="footer">© 2026 Linux Downloader · تجربة أولية</footer>
</div>
<script>
const input=document.getElementById('url'),result=document.getElementById('result');
document.getElementById('paste').addEventListener('click',async()=>{try{input.value=await navigator.clipboard.readText();input.focus()}catch(e){input.focus();input.placeholder='الصق الرابط هنا باستخدام لصق من لوحة المفاتيح'}});
document.getElementById('process').addEventListener('click',async()=>{const v=input.value.trim();if(!v){input.focus();input.placeholder='أدخل رابط الفيديو أولاً';return}let host='الرابط';try{const u=new URL(v);if(!['http:','https:'].includes(u.protocol))throw 0;host=u.hostname.replace(/^www\\./,'')}catch(e){input.focus();input.placeholder='أدخل رابطًا صحيحًا يبدأ بـ https://';return}const btn=document.getElementById('process');btn.disabled=true;btn.textContent='جارٍ تحليل الرابط…';document.getElementById('platform').textContent='تحليل رابط '+host;document.getElementById('message').textContent='نتواصل مع خدمة التنزيل…';result.classList.add('show');try{const r=await fetch('/api/resolve',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:v,quality:document.querySelector('.quality button.active')?.textContent||'أفضل جودة'})});const data=await r.json();if(!r.ok)throw new Error(data.error||'تعذر تحليل الرابط');document.getElementById('message').textContent=data.message||'تم تجهيز الرابط.';let area=result.querySelector('.downloadmock');area.innerHTML='';if(data.url){const a=document.createElement('a');a.href=data.url;a.textContent='تنزيل الفيديو';a.target='_blank';a.rel='noopener';a.style='display:inline-block;margin-top:10px;padding:11px 16px;background:#7652df;color:white;border-radius:10px;text-decoration:none;font-weight:700';area.appendChild(a)}else{area.textContent='الخدمة لم تُرجع رابط تنزيل مباشر.'}}catch(e){document.getElementById('message').textContent=e.message+' — تأكد من إعداد خدمة Cobalt في الخادم.';result.querySelector('.downloadmock').textContent='لم يتم إنشاء رابط تنزيل.'}finally{btn.disabled=false;btn.innerHTML='تحليل الرابط';result.scrollIntoView({behavior:'smooth',block:'nearest'})}});
document.querySelectorAll('.quality button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.quality button').forEach(x=>x.classList.remove('active'));b.classList.add('active')}));
</script>
</body></html>
